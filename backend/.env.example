# =============================================================================
# Weather API - environment template
# Copy this file to .env.dev or .env.prod and fill in the values.
# This file IS committed to Git. Never put real secrets in it.
# =============================================================================

# --- App ----------------------------------------------------------------------
# Which environment is running: dev | prod
APP_ENV=dev
FLASK_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8080
LOG_LEVEL=INFO

# --- Weather provider selection -----------------------------------------------
# Provider used when the client does not send ?api_source=
DEFAULT_WEATHER_API_SOURCE=visualcrossing
# --- add the weather provider of your choosing --------------------------------
WEATHER_PROVIDER=

# --- Outbound HTTP ------------------------------------------------------------
# Seconds to wait for the 3rd party API before giving up
HTTP_TIMEOUT_SECONDS=10

# --- Visual Crossing ----------------------------------------------------------
VISUAL_CROSSING_API_KEY=
VISUAL_CROSSING_DOMAIN=https://weather.visualcrossing.com
VISUAL_CROSSING_PATH=/VisualCrossingWebServices/rest/services/timeline/
VISUAL_CROSSING_UNIT_GROUP=us
# Comma-separated list (env vars are always strings)
VISUAL_CROSSING_INCLUDE="hours,events,alerts"
VISUAL_CROSSING_CONTENT_TYPE=json

# --- Redis --------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# --- Cache --------------------------------------------------------------------
# How long a cached forecast lives, in seconds (43200 = 12 hours)
CACHE_TTL_SECONDS=43200
CACHE_KEY_PREFIX=agg_weather_data

# --- Rate limiting (Flask-Limiter) --------------------------------------------
RATE_LIMIT_DEFAULT=60 per minute
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/1

# --- Admin --------------------------------------------------------------------
# Token required to call DELETE /weather/clear
CACHE_CLEAR_TOKEN=
